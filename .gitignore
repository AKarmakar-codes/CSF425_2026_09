# ==============================================================================
# CS F425 - Deep Learning (Group G09)
# Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & Credentials (Mandatory per Section 1.1)
# Never commit HPC private keys or credentials to Git
# ------------------------------------------------------------------------------
csisdl_*
*.pem
*.key
id_rsa*
id_ed25519*
.env
.env.*
*.secret

# ------------------------------------------------------------------------------
# 2. Python Bytecode, Caches & Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.deps/

# Jupyter / IPython
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 3. Large Datasets & Archives (Do not commit multi-GB archives)
# ------------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Raw dataset directories and symlinks
**/data/GraphPCB/
**/data/GraphPCB
**/data/coco_pcb_640/
**/data/crops/
**/data/classification_ready*/
**/data/prepared*/
**/data/distilled_source/
**/pcb_dslr_download/
**/part_*/
**/cvl_pcb_dslr_*/
*.pcb64

# ------------------------------------------------------------------------------
# 4. Training Runs, Logs & Temporary Files
# ------------------------------------------------------------------------------
runs/
**/runs/
wandb/
*.log
*.tmp
*.swp
*~
tmp/
/tmp/

# ------------------------------------------------------------------------------
# 5. OS & Editor Specific
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 6. Model checkpoints
# Keep the two required Assignment-II checkpoints. Ignore other raw weights by
# default: several Assignment-I checkpoints exceed GitHub's 100 MB file limit.
# Use Git LFS or a release/artifact store if those large weights must be shared.
# ------------------------------------------------------------------------------
*.ckpt
*.pth
*.pt
**/checkpoints/*.tmp

# Explicitly keep required Assignment-II model artifacts and directory marker.
!ASSIGNMENT 2/checkpoints/.gitkeep
!ASSIGNMENT 2/checkpoints/best_semantic.ckpt
!ASSIGNMENT 2/checkpoints/best_instance.ckpt

# Keep Assignment-II planning/status documents stageable even if broad text
# ignores are added later.
!ASSIGNMENT 2/plan.txt
!ASSIGNMENT 2/ASSIGNMENT_STATUS.md
