# ==============================================================================
# CS F425 - Deep Learning (Group G09)
# Master .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security, Credentials & API Keys
# Never commit HPC private keys, API tokens, or secrets to Git
# ------------------------------------------------------------------------------
csisdl_*
*.pem
*.key
*.cer
*.crt
*.pfx
*.p12
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*
.env
.env.*
!.env.example
*.secret
*.credentials
kaggle.json
wandb_api_key.txt

# ------------------------------------------------------------------------------
# 2. Python Bytecode, Caches & Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.deps/

# Jupyter / IPython
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Testing & Linting
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 3. Large Datasets, Tiled Data & Archives (Do not commit multi-GB datasets)
# ------------------------------------------------------------------------------
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Raw and prepared dataset directories
prepared_tiles/
**/prepared_tiles/
**/prepared*/
prepared_data/
**/prepared_data/
tiles/
**/tiles/
**/data/GraphPCB/
**/data/GraphPCB
**/data/coco_pcb_640/
**/data/crops/
**/data/classification_ready*/
**/data/distilled_source/
**/pcb_dslr_download/
**/part_*/
**/cvl_pcb_dslr_*/
*.pcb64

# ------------------------------------------------------------------------------
# 4. Training Runs, Logs & Temporary Files
# ------------------------------------------------------------------------------
runs/
**/runs/
wandb/
work_dirs/
**/work_dirs/
lightning_logs/
**/lightning_logs/
events.out.tfevents.*
*.log
*.log.json
*.tmp
*.swp
*~
tmp/
/tmp/
.cache/
**/.cache/

# ------------------------------------------------------------------------------
# 5. OS & Editor Specific
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 6. Model Checkpoints & Weights
# Keep only explicitly required lightweight checkpoints (<100MB).
# Ignore other raw weights to stay within GitHub's file limit.
# ------------------------------------------------------------------------------
*.ckpt
*.pth
*.pt
*.bin
*.safetensors
*.onnx
*.engine
**/checkpoints/*.tmp

# Explicitly keep required Assignment-II model artifacts and directory markers
!ASSIGNMENT 2/checkpoints/.gitkeep
!ASSIGNMENT 2/checkpoints/best_semantic.ckpt
!ASSIGNMENT 2/checkpoints/best_instance.ckpt
!ASSIGNMENT 2/checkpoints/run3_full_history.json

# Explicitly keep Assignment-I checkpoint documentation / markers
!ASSIGNMENT 1/checkpoints/README.md
!ASSIGNMENT 1/checkpoints/.gitkeep

# Keep Assignment-II planning/status documents stageable
!ASSIGNMENT 2/plan.txt
!ASSIGNMENT 2/ASSIGNMENT_STATUS.md
